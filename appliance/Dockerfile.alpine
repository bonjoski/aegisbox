FROM golang:1.24-alpine AS builder

WORKDIR /src
COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o /bin/aegisbox-guest ./cmd/aegisbox-guest

FROM alpine:3.20

RUN apk add --no-cache \
    bash \
    curl \
    python3 \
    git \
    nmap \
    iproute2 \
    iptables \
    squashfs-tools \
    ca-certificates

COPY --from=builder /bin/aegisbox-guest /usr/local/bin/aegisbox-guest

EXPOSE 1024
ENTRYPOINT ["/usr/local/bin/aegisbox-guest"]
